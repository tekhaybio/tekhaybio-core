MONGODB_URI=mongodb://127.0.0.1/tek-hay-bio
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Vercel Blob (Dipertahankan di konfigurasi tetapi dinonaktifkan dalam alur aktif)
BLOB_READ_WRITE_TOKEN=

# Cloudflare R2 Storage (Penyimpanan Aktif berbasis S3-compatible API)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
R2_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com
# R2_PUBLIC_URL: Domain publik bucket Cloudflare R2 (contoh: https://pub-xxxxxx.r2.dev atau custom domain https://media.yourdomain.com)
R2_PUBLIC_URL=https://pub-your_public_hash.r2.dev
